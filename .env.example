# auto: live with credentials; demo without. Set demo/live to choose explicitly.
APP_DATA_MODE=auto

# Copy to .env.local; never commit keys.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Use the production HTTPS origin on Vercel (also required for mobile AR).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Required for Vercel live builds; use the separate staging project's ref there.
# Guards accidental deployment to a different Supabase project. Not a secret.
# SUPABASE_EXPECTED_PROJECT_REF=

# For the CLI only, never expose in NEXT_PUBLIC_* variables or commit secrets.
# SUPABASE_PROJECT_ID=
# SUPABASE_ACCESS_TOKEN=
# SUPABASE_DB_PASSWORD=

# Optional development integration scripts only; keep actual values in .env.local.
# Never prefix staff credentials or verification tokens with NEXT_PUBLIC_.
# STAFF_TEST_EMAIL=
# STAFF_TEST_PASSWORD=
# ORDER_SESSION_TEST_TABLE_TOKEN=

# Server-only validated media gateway. NEVER prefix with NEXT_PUBLIC_.
# SUPABASE_SERVICE_ROLE_KEY=

# Explicit local-only QA provisioning, never an app/Vercel setting.
# A separately authorized administrative context is required; no media-key fallback.
# PILOT_QA_ADMIN_KEY=
