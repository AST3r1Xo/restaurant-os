{
  "name": "restaurant-os",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test:db": "node --test tests/database.test.mjs tests/order-database.test.mjs tests/kitchen-database.test.mjs tests/history-database.test.mjs tests/session-database.test.mjs tests/menu-admin-database.test.mjs tests/opening-database.test.mjs",
    "verify:supabase": "node scripts/verify-supabase.mjs",
    "db:types": "node scripts/generate-database-types.mjs",
    "test:menu": "node --test tests/menu.test.mjs",
    "test:cart": "node --test tests/cart.test.mjs",
    "test:orders": "node --test tests/orders-server.test.mjs tests/order-submission.test.mjs",
    "test:kitchen": "node --test tests/kitchen.test.mjs",
    "test:history": "node --test tests/history.test.mjs",
    "test:sessions": "node --test tests/sessions.test.mjs",
    "test:ar": "node --test tests/ar.test.mjs",
    "test:admin": "node --test tests/menu-admin.test.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:pilot": "node --test tests/pilot.test.mjs",
    "test:opening": "node --test tests/opening-database.test.mjs tests/table-qr.test.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "measure:pages": "node scripts/measure-pages.mjs",
    "preview:model": "node scripts/preview-local-model.mjs",
    "storage:setup": "node --env-file=.env.local scripts/setup-media-storage.mjs"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@google/model-viewer": "4.4.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.3",
    "clsx": "2.1.1",
    "fflate": "0.8.3",
    "lucide-react": "1.57.0",
    "next": "16.4.0",
    "pdf-lib": "1.17.1",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.9",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "jsqr": "1.4.0",
    "postcss": "8.5.30",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  }
}
